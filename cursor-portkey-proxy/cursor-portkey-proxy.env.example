# Portkey API key used by the proxy when calling the upstream Portkey endpoint.
PORTKEY_API_KEY=

# Secret key clients (e.g. Cursor) send as "Authorization: Bearer <key>".
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
PROXY_API_KEY=

# Base URL of the Portkey API gateway.
PORTKEY_URL=https://api.portkey.ai/v1

# Model name exposed to Cursor on /v1/models and expected from Cursor requests.
CURSOR_MODEL=kimi-k2.7-code-portkey

# Actual Portkey model name used in upstream /v1/chat/completions requests.
PORTKEY_MODEL=kimi-k2.7-code

# Interface the proxy binds to. 0.0.0.0 accepts all interfaces; 10.0.0.1 is the
# Docker host gateway used in the Caddy setup so the proxy is not public on
# the VPS's main IP.
HOST=10.0.0.1

# TCP port the proxy listens on.
PORT=8000

# When true, the proxy forces non-streaming upstream requests even if Cursor
# asks for streaming. Keep false for real streaming behavior.
FORCE_NONSTREAM=false

# Seconds between SSE keepalive chunks sent to Cursor while waiting for
# upstream data. Prevents idle timeouts during long streaming responses.
KEEPALIVE_INTERVAL=10

# Maximum seconds an upstream HTTP read may remain open. Increase this for very
# long-running requests (e.g. large tool-result contexts or slow models).
UPSTREAM_TIMEOUT=3600
